# decision: declarative decision logic in AQL — conditions, predicates,
# decision tables, and decision trees, evaluated against an input Map.
#
# Public surface (the Decision namespace exported at the bottom). The
# canonical call form is forward — `Decision.verb arg1 arg2 …`:
#
#   Builders (construct records):
#     Decision.cond field op value      → Cond        (a field/op/value test)
#     Decision.all-of children          → Pred        (every child must hold)
#     Decision.any-of children          → Pred        (some child must hold)
#     Decision.not-of child             → Pred        (negate one condition)
#     Decision.make-rule when then       → Rule        (a when→then pairing)
#     Decision.make-table rules          → DTable      (hit-policy "first")
#     Decision.with-policy policy table  → DTable      (swap the hit policy)
#     Decision.make-branch id branches   → BranchNode  (interior tree node)
#     Decision.make-leaf id result       → LeafNode    (terminal tree node)
#     Decision.make-tree root nodes      → DTree
#
#   Evaluators (apply a model/condition against an input Map):
#     Decision.apply-op rhs op lhs      → Boolean     (the primitive compare)
#     Decision.eval-cond cond input      → Boolean
#     Decision.eval-pred pred input      → Boolean
#     Decision.eval-table table input    → then-result | {ok:false error:…}
#     Decision.eval-tree tree input      → leaf-result | {ok:false error:…}
#     Decision.decide model input        → dispatches on model kind (table/tree)
#
# --- representation -------------------------------------------------
#
# Conditions, predicates, rules, tables, and trees are plain `refine
# Record` values (Cond, Pred, Rule, DTable, DTree, BranchNode, LeafNode),
# so you can build them with the builders OR write them as Map literals —
# the evaluators only read fields. An evaluator returns the matching
# `then`/leaf result, or an error Map `{ok:false error:"…"}` (no-match,
# multiple-matches, unknown-model-kind, node-not-found, …).
#
# Comparable is a SURFACE — the `cmp` contract that the ordering ops
# (lt/lte/gt/gte) require. The scalar builtins expose it; a user type
# joins by exposing Comparable itself. eq/neq work for any value.
#
# Calling convention: forward, the verb first, with the RECEIVER (the
# model/input) LAST — `Decision.eval-table table input` /
# `Decision.decide model input`. Piping the input in from the left also
# binds (`input Decision.decide model`); putting the receiver first does
# not. Wrap a call in parens when its result is used as a value.
#
# Imported via `import "./decision.aql"` — a relative import resolves
# against the IMPORTING file's own directory (a suite under test/ writes
# `import "../decision.aql"`). Verified against boru main @ 64c5ab2 (uses
# surface / exposes / generics / refine Record / fnsig). No boru:* deps.


# ============================================================
# Record types and builder functions
# ============================================================

# Comparable is the SURFACE the relational operators require: a type is
# Comparable iff it exposes the cmp contract. The scalar builtins the
# decision operators compare are declared here; user types join by
# exposing Comparable themselves.
def Comparable surface {cmp: (fnsig [[Self Self] [Integer]])}
Integer exposes Comparable
Float exposes Comparable
String exposes Comparable
Boolean exposes Comparable
Atom exposes Comparable

def Cond refine Record [field:Atom op:String value:Any]
def Pred refine Record [kind:String op:String children:Any]

# Rule/LeafNode are generic in the RESULT type R; builders construct
# through the bare-schema form, so R infers from the rule's output
# (then/result). DTable/DTree carry R as a defaulted parameter (their
# fields hold rule/node LISTS, which give no direct evidence) so bare
# construction still works.
def Rule gen [R] refine Record [when:Map then:R]
def DTable gen [(R default Any)] refine Record [kind:String rules:List hit-policy:String]
def BranchNode refine Record [id:Atom kind:String branches:List]
def LeafNode gen [R] refine Record [id:Atom kind:String result:R]
def DTree gen [(R default Any)] refine Record [kind:String root:Atom nodes:List]

def cond fn [[field:Atom op:String value:Any] [Map] [
  make Cond {field:field op:op value:value}
]]

def all-of fn [[children:List] [Map] [
  make Pred {kind:"group" op:"all" children:children}
]]

def any-of fn [[children:List] [Map] [
  make Pred {kind:"group" op:"any" children:children}
]]

def not-of fn [[child:Map] [Map] [
  make Pred {kind:"group" op:"not" children:child}
]]

def make-rule fn [[when:Map then:Map] [Map] [
  make Rule {when:when then:then}
]]

def make-table fn [[rules:List] [Map] [
  make DTable {kind:"table" rules:rules hit-policy:"first"}
]]

def with-policy fn [[policy:String table:Map] [Map] [
  make DTable {kind:(table.kind) rules:(table.rules) hit-policy:policy}
]]

def make-branch fn [[id:Atom branches:List] [Map] [
  make BranchNode {id:id kind:"branch" branches:branches}
]]

def make-leaf fn [[id:Atom result:Any] [Map] [
  make LeafNode {id:id kind:"leaf" result:result/v}
]]

def make-tree fn [[root:Atom nodes:List] [Map] [
  make DTree {kind:"tree" root:root nodes:nodes}
]]

# ============================================================
# Evaluators
# ============================================================

# --- apply-op ---

# The binary form is GENERIC over Comparable: the ORDERING ops
# (lt/lte/gt/gte) require both operands in the surface, while eq/neq are
# equality — defined for everything — so the Any overload (sorted after
# the bounded sig) handles them and RAISES when an ordering op reaches it
# with non-Comparable operands, instead of a silent false.
def apply-op gen [(T extends Comparable)] fn [[rhs:T op:String lhs:T] [Boolean] [if (op "eq" eq) [lhs rhs eq] [if (op "neq" eq) [lhs rhs neq] [if (op "lt" eq) [lhs rhs lt] [if (op "lte" eq) [lhs rhs lte] [if (op "gt" eq) [lhs rhs gt] [if (op "gte" eq) [lhs rhs gte] [raise unknown_op op]]]]]]] [rhs:Any op:String lhs:Any] [Boolean] [if (op "eq" eq) [lhs rhs eq] [if (op "neq" eq) [lhs rhs neq] [raise not_comparable op]]]]

# The unary form recognises its four ops and RAISES on anything else — so
# an unknown op (or a relational op whose non-Comparable operand fell past
# the generic sig above into this catch-all) is a loud unknown_op error
# rather than a silent false.
def apply-op fn [[rhs:Any op:String] [Boolean] [if (op "is_true" eq) [rhs] [if (op "is_false" eq) [rhs not] [if (op "is_null" eq) [false] [if (op "is_not_null" eq) [true] [raise unknown_op op]]]]]]

# --- eval-cond ---

def eval-cond fn [[c:Map input:Map] [Boolean] [input.((c.field convert String)) c.op c.value apply-op]]

# --- eval-pred helpers ---
# eval-pred-all/any fold per-child eval-pred results with the matching
# list-quantifier word (all/any), which short-circuit at the quantifier.

def eval-pred-all fn [[children:List input:Map] [Boolean] [(children each [input swap eval-pred]) all]]

def eval-pred-any fn [[children:List input:Map] [Boolean] [(children each [input swap eval-pred]) any]]

def eval-pred-not fn [[children:Map input:Map] [Boolean] [input children eval-cond not]]
def eval-pred-not fn [[children:List input:Map] [Boolean] [input (children 0 get) eval-pred not]]

# --- eval-pred ---
#
# `as-map` is the identity on a Map. The kind-dispatching words (eval-pred
# here, decide below) pass the record to each arm through it. On boru main
# @ 64c5ab2, `boru check` (and so the pre-flight check of `boru file`)
# analyses an IMPORTED fn's untaken arm with the caller's concrete
# Map-literal argument. It reads the absent field as None and reports
# `no_signature`, which blocks a correct run. Two examples: a bare
# condition literal given to `Decision.eval-pred` is analysed through the
# group arm (`children` is None), and a literal tree given to
# `Decision.decide` is analysed through the table arm (`rules` is None).
# Declared `[Map]`, `as-map` hands each arm a plain Map instead of the
# literal's shape. Works around that boru check false positive (dx-report.md,
# open defect F) — remove when fixed upstream.

def as-map fn [[m:Map] [Map] [m]]

def eval-pred fn [[pred:Map input:Map] [Boolean] [if ((pred get "kind") "group" eq) [(def group-op (pred get "op") def children quote ((pred as-map) get "children") if (group-op "all" eq) [input children eval-pred-all] [if (group-op "any" eq) [input children eval-pred-any] [if (group-op "not" eq) [input children eval-pred-not] [false]]])] [input (pred as-map) eval-cond]]]

# --- eval-table helpers ---
#
# The miss results below are plain Map literals. They were written
# `(do {ok: false, error: "…"})`; on boru main @ 64c5ab2 a fn-local def
# followed by `def x (do {map})` breaks later loop-body reads of that local
# when compiled — eval-tree declined to compile ("a gradual read in a nested
# body has no seated guard … (NUR361)") and the same shape elsewhere raised
# `undefined word` at run time. A literal of literal values needs no `do`,
# so dropping it is equivalent. Works around that boru compile defect —
# the `do` may come back once it is fixed upstream (see dx-report.md).

def eval-table-first fn [[rules:List input:Map] [Any] [def result {ok: false, error: "no-match"} def found false for (rules size) [def idx i def rule (rules idx get) if (found not) [if (input (rule get "when") eval-pred) [def result (rule get "then") def found true] []] []] end result/v]]

def eval-table-unique fn [[rules:List input:Map] [Any] [def result {ok: false, error: "no-match"} def match-count 0 for (rules size) [def idx i def rule (rules idx get) if (input (rule get "when") eval-pred) [def result (rule get "then") def match-count (match-count 1 add)] []] end if (match-count 1 eq) [result/v] [if (match-count 0 eq) [{ok: false, error: "no-match"}] [{ok: false, error: "multiple-matches"}]]]]

def eval-table-collect fn [[rules:List input:Map] [Any] [def results quote [] for (rules size) [def idx i def rule (rules idx get) if (input (rule get "when") eval-pred) [def results (quote (results (rule get "then") push))] []] end results]]

def eval-table-priority fn [[rules:List input:Map] [Any] [def best {ok: false, error: "no-match"} def best-pri 0 def found false for (rules size) [def idx i def rule (rules idx get) if (input (rule get "when") eval-pred) [def pri (if ((rule get "priority") None neq) [(rule get "priority")] [0]) if (found not) [def best (rule get "then") def best-pri pri def found true] [if (pri best-pri gt) [def best (rule get "then") def best-pri pri] []]] []] end best/v]]

# --- eval-table ---

def eval-table fn [[table:Map input:Map] [Any] [def rules quote (table get "rules") def policy (table get "hit-policy") if (policy "first" eq) [input rules eval-table-first] [if (policy "unique" eq) [input rules eval-table-unique] [if (policy "collect" eq) [input rules eval-table-collect] [if (policy "priority" eq) [input rules eval-table-priority] [input rules eval-table-first]]]]]]

# --- eval-tree helpers ---

def find-node fn [[id:Any nodes:List] [Any] [def found None for (nodes size) [def idx i def nd (nodes idx get) if ((nd get "id" convert String) (id convert String) eq) [def found nd] []] end found/v]]

def find-branch-next fn [[branches:List input:Map] [Any] [def next-id None for (branches size) [def idx i def br (branches idx get) if (input (br get "when") eval-pred) [def next-id (br get "next")] []] end next-id/v]]

# --- eval-tree ---

def eval-tree fn [[tree:Map input:Map] [Any] [def nodes quote (tree get "nodes") def current (nodes (tree get "root") find-node) def done false def result {ok: false, error: "max-depth-exceeded"} for 100 [def _i i if (done not) [if ((current get "kind") "leaf" eq) [def result (current get "result") def done true] [if ((current get "kind") "branch" eq) [(def next-id (input quote (current get "branches") find-branch-next) if (next-id None eq) [def result {ok: false, error: "no-branch-match"} def done true] [def current (nodes next-id find-node) if (current None eq) [def result {ok: false, error: "node-not-found"} def done true] []])] [def result {ok: false, error: "unknown-node-kind"} def done true]]] []] end result/v]]

# --- decide ---

def decide fn [[model:Map input:Map] [Any] [if ((model get "kind") "table" eq) [input (model as-map) eval-table] [if ((model get "kind") "tree" eq) [input (model as-map) eval-tree] [{ok: false, error: "unknown-model-kind"}]]]]

# ============================================================
# Exports
# ============================================================

export "Decision" {
  Comparable:  Comparable
  Cond:        Cond
  Pred:        Pred
  Rule:        Rule
  DTable:      DTable
  BranchNode:  BranchNode
  LeafNode:    LeafNode
  DTree:       DTree
  cond:        cond/v
  all-of:      all-of/v
  any-of:      any-of/v
  not-of:      not-of/v
  make-rule:   make-rule/v
  make-table:  make-table/v
  with-policy: with-policy/v
  make-branch: make-branch/v
  make-leaf:   make-leaf/v
  make-tree:   make-tree/v
  apply-op:    apply-op/v
  eval-cond:   eval-cond/v
  eval-pred:   eval-pred/v
  eval-table:  eval-table/v
  eval-tree:   eval-tree/v
  decide:      decide/v
}
